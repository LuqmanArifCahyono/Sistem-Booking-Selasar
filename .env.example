# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env.

# ===== Database =====
# Lokal cepat (nol instalasi): SQLite
DATABASE_URL="file:./prisma/dev.db"
# Lokal dengan phpMyAdmin (XAMPP): aktifkan lewat `npm run db:use-mysql`
# DATABASE_URL="mysql://root:@127.0.0.1:3306/selasarspace"
# Produksi (Supabase Postgres) nanti, saat deploy:
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# ===== Auth.js =====
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="ganti-dengan-string-acak-panjang"
AUTH_TRUST_HOST=true

# ===== Telegram Bot API (opsional) =====
# Buat bot lewat @BotFather, lalu isi token dan chat ID grup tujuan notifikasi.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
